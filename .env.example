# Local MVP: no API key, database service, or package download required.
HOST=127.0.0.1
PORT=3000
APP_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/careeros.sqlite
# Refresh while this process is running. Set 0 to disable.
REFRESH_HOURS=12
# Optional cron endpoint Bearer token (generate: openssl rand -hex 32).
CRON_SECRET=
# Set true ONLY behind an HTTPS reverse proxy with a matching APP_URL.
SECURE_COOKIES=false
